# Leave empty so the SPA calls /auth, /cases, and /audit on the same origin.
# Local: server/middleware/dev-api-proxy.ts forwards those paths to Identity (5250),
# Origination (5135), and Audit (5320). HTML navigations to /cases and /audit stay on Nuxt.
NUXT_PUBLIC_IDENTITY_API_URL=
NUXT_PUBLIC_ORIGINATION_API_URL=
NUXT_PUBLIC_AUDIT_API_URL=
